<?xml version="1.0"?>
<sdf version="1.6">

  <model name="turtlebot3_burger_camera">

    <static>false</static>

    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint">

      <pose>0 0 0.01 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

    </link>

    <link name="base_link">

      <pose>0 0 0.01 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="base_visual">

        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/bases/burger_base.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>

      </visual>

      <collision name="base_collision">

        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.13</length>
          </cylinder>
        </geometry>

      </collision>

    </link>

    <joint name="base_footprint_joint" type="fixed">

      <parent>base_footprint</parent>
      <child>base_link</child>

      <pose>0 0 0 0 0 0</pose>

    </joint>

    <link name="wheel_left_link">

      <pose>0 0.08 0.033 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="wheel_left_visual">

        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>

      </visual>

      <collision name="wheel_left_collision">

        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>

      </collision>

    </link>

    <link name="wheel_right_link">

      <pose>0 -0.08 0.033 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="wheel_right_visual">

        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>

      </visual>

      <collision name="wheel_right_collision">

        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>

      </collision>

    </link>

    <joint name="wheel_left_joint" type="continuous">

      <parent>base_link</parent>
      <child>wheel_left_link</child>

      <pose>0 0.08 0.033 0 0 0</pose>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>

    <joint name="wheel_right_joint" type="continuous">

      <parent>base_link</parent>
      <child>wheel_right_link</child>

      <pose>0 -0.08 0.033 0 0 0</pose>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>

    <link name="caster_back_link">

      <pose>-0.081 0 0.008 0 0 0</pose>

      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="caster_visual">

        <geometry>
          <sphere>
            <radius>0.008</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

      </visual>

      <collision name="caster_collision">

        <geometry>
          <sphere>
            <radius>0.008</radius>
          </sphere>
        </geometry>

      </collision>

    </link>

    <joint name="caster_back_joint" type="fixed">

      <parent>base_link</parent>
      <child>caster_back_link</child>

      <pose>-0.081 0 0.008 0 0 0</pose>

    </joint>

    <link name="imu_link">

      <pose>-0.032 0 0.068 0 0 0</pose>

      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <sensor name="tb3_imu" type="imu">

        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>

        <imu>

          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </z>
          </angular_velocity>

          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </z>
          </linear_acceleration>

        </imu>

        <plugin
          name="imu_plugin"
          filename="libgazebo_ros_imu_sensor.so">

          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>

          <frame_name>imu_link</frame_name>

        </plugin>

      </sensor>

    </link>

    <joint name="imu_joint" type="fixed">

      <parent>base_link</parent>
      <child>imu_link</child>

      <pose>-0.032 0 0.068 0 0 0</pose>

    </joint>

    <link name="base_scan">

      <pose>-0.032 0 0.172 0 0 0</pose>

      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">

        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/sensors/lds.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </visual>

      <collision name="lidar_collision">

        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>

      </collision>

      <sensor name="hlds_laser" type="ray">

        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>30</update_rate>

        <ray>

          <scan>

            <horizontal>

              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28</max_angle>

            </horizontal>

          </scan>

          <range>

            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.01</resolution>

          </range>

        </ray>

        <plugin
          name="gazebo_ros_laser"
          filename="libgazebo_ros_ray_sensor.so">

          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>

          <output_type>sensor_msgs/LaserScan</output_type>

          <frame_name>base_scan</frame_name>

        </plugin>

      </sensor>

    </link>

    <joint name="scan_joint" type="fixed">

      <parent>base_link</parent>
      <child>base_scan</child>

      <pose>-0.032 0 0.172 0 0 0</pose>

    </joint>

    <link name="camera_link">

      <pose>0.105 0.0 0.45 0.0 0.0 0.0</pose>

      <inertial>

        <mass>0.05</mass>

        <inertia>

          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>

          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>

          <izz>0.0001</izz>

        </inertia>

      </inertial>

      <visual name="camera_visual">

        <geometry>

          <box>
            <size>0.065 0.05 0.04</size>
          </box>

        </geometry>

        <material>

          <ambient>0.02 0.02 0.02 1.0</ambient>
          <diffuse>0.02 0.02 0.02 1.0</diffuse>

        </material>

      </visual>

      <collision name="camera_collision">

        <geometry>

          <box>
            <size>0.065 0.05 0.04</size>
          </box>

        </geometry>

      </collision>

      <sensor
        name="camera"
        type="depth">

        <always_on>true</always_on>

        <visualize>false</visualize>

        <update_rate>30</update_rate>

        <camera>

          <horizontal_fov>1.0471976</horizontal_fov>

          <image>

            <width>640</width>
            <height>480</height>
            <format>B8G8R8</format>

          </image>

          <depth_camera>
          </depth_camera>

          <clip>

            <near>0.10</near>
            <far>10.0</far>

          </clip>

          <noise>

            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>

          </noise>

        </camera>

        <plugin
          name="camera_controller"
          filename="libgazebo_ros_camera.so">

          <ros>

            <namespace>/camera</namespace>

            <remapping>
              camera/image_raw:=rgb/image_raw
            </remapping>

            <remapping>
              camera/depth/image_raw:=depth/image_raw
            </remapping>

            <remapping>
              camera/camera_info:=rgb/camera_info
            </remapping>

            <remapping>
              camera/depth/camera_info:=depth/camera_info
            </remapping>

            <remapping>
              camera/points:=depth/points
            </remapping>

          </ros>

          <camera_name>camera</camera_name>

          <frame_name>camera_link</frame_name>

          <min_depth>0.10</min_depth>

          <max_depth>10.0</max_depth>

        </plugin>

      </sensor>

    </link>

    <joint name="camera_joint" type="fixed">

      <parent>base_link</parent>
      <child>camera_link</child>

      <pose>0.105 0.0 0.45 0.0 0.0 0.0</pose>

    </joint>

    <plugin
      name="turtlebot3_diff_drive"
      filename="libgazebo_ros_diff_drive.so">

      <ros>

        <namespace>/</namespace>

      </ros>

      <update_rate>30</update_rate>

      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <wheel_separation>0.160</wheel_separation>

      <wheel_diameter>0.066</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>

      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <odometry_topic>odom</odometry_topic>

      <odometry_frame>odom</odometry_frame>

      <robot_base_frame>base_footprint</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>

    <plugin
      name="joint_state_publisher"
      filename="libgazebo_ros_joint_state_publisher.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>30</update_rate>

      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>

    </plugin>

  </model>

</sdf>
